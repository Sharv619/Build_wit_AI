{
  "name": "pilly-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test",
    "lint": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.js",
    "test:rules": "npm run build && firebase --config ../firebase.json emulators:exec --only firestore,storage \"node --test test/security-rules.test.js test/callable-auth.test.js\"",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth,storage",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions,firestore:rules,storage"
  },
  "dependencies": {
    "@google-cloud/text-to-speech": "^6.4.1",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase-tools": "^15.19.0",
    "typescript": "^5.7.2"
  }
}
