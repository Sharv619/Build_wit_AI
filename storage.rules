rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/(default)/documents/users/$(request.auth.uid);
    }

    function userExists() {
      return signedIn() && firestore.exists(userPath());
    }

    function isHouseholdMember(householdId) {
      return userExists() &&
        firestore.get(userPath()).data.householdId == householdId &&
        firestore.get(userPath()).data.role in ['senior', 'spouse', 'caregiver', 'family'];
    }

    function isCaregiverFor(householdId) {
      return isHouseholdMember(householdId) &&
        firestore.get(userPath()).data.role in ['caregiver', 'family'];
    }

    function isAudioUpload() {
      return request.resource != null &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('audio/.*');
    }

    match /scriptUploads/{householdId}/{fileName} {
      allow read: if isCaregiverFor(householdId);
      allow create, update: if isCaregiverFor(householdId) &&
        request.resource != null &&
        request.resource.size < 10 * 1024 * 1024;
      allow delete: if false;
    }

    match /households/{householdId}/voiceReminders/{fileName} {
      allow read: if isHouseholdMember(householdId);
      allow create, update: if isCaregiverFor(householdId) && isAudioUpload();
      allow delete: if isCaregiverFor(householdId);
    }

    match /households/{householdId}/voiceCloneSamples/{fileName} {
      // Voice cloning is disabled in this patch batch. Do not accept biometric-like
      // voice samples until consent, retention, deletion, and audit controls exist.
      allow read, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
