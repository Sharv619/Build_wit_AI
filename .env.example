# Optional server-side Gemini key for Firebase Cloud Functions.
# The demo works without this key by using deterministic fallback classification.
GEMINI_API_KEY=

# Optional ElevenLabs key for explicit-consent voice cloning.
# Required for createElevenLabsVoiceClone and generateClonedVoiceReminderAudio.
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# Firebase project identifier used by local tooling or deployment scripts.
FIREBASE_PROJECT_ID=medimate-voice-demo

# Optional for local Google Cloud Text-to-Speech development.
# Prefer `gcloud auth application-default login` when possible.
# If you use a service-account JSON locally, keep it outside git and point to it here:
# GOOGLE_APPLICATION_CREDENTIALS=C:\absolute\path\to\service-account.json
