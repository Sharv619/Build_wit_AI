rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isDemoHousehold(householdId) {
      return householdId == 'demo-household-eleanor';
    }

    // Demo-only escape hatch for public hackathon data. Production must remove
    // unauthenticated demo access and require explicit household membership.
    function isDemoReadableHousehold(householdId) {
      return isDemoHousehold(householdId);
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function householdIdFor(uid) {
      return userDoc(uid).data.householdId;
    }

    function isLinkedToHousehold(householdId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        householdIdFor(request.auth.uid) == householdId;
    }

    function isCaregiverFor(householdId) {
      return isLinkedToHousehold(householdId) &&
        userDoc(request.auth.uid).data.role in ['caregiver', 'family'];
    }

    match /users/{userId} {
      allow read: if isDemoReadableHousehold(resource.data.householdId) || signedIn() && (
        request.auth.uid == userId ||
        householdIdFor(request.auth.uid) == resource.data.householdId
      );
      allow create: if request.resource.data.householdId == 'demo-household-eleanor' || signedIn() && (
        request.auth.uid == userId ||
        isCaregiverFor(request.resource.data.householdId)
      );
      allow update: if resource.data.householdId == 'demo-household-eleanor' || signedIn() && (
        request.auth.uid == userId ||
        isCaregiverFor(resource.data.householdId)
      );
      allow delete: if false;
    }

    match /households/{householdId} {
      allow read: if isDemoReadableHousehold(householdId) || isLinkedToHousehold(householdId);
      allow create: if isDemoHousehold(householdId) || signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isDemoHousehold(householdId) || isCaregiverFor(householdId);
      allow delete: if false;
    }

    match /medications/{medicationId} {
      allow read: if isDemoReadableHousehold(resource.data.householdId) || isLinkedToHousehold(resource.data.householdId);
      allow create: if isDemoHousehold(request.resource.data.householdId) || isCaregiverFor(request.resource.data.householdId);
      allow update: if isDemoHousehold(resource.data.householdId) || isCaregiverFor(resource.data.householdId);
      allow delete: if false;
    }

    match /routineEvents/{eventId} {
      allow read: if isDemoReadableHousehold(resource.data.householdId) || isLinkedToHousehold(resource.data.householdId);
      // Core event completion should go through Cloud Functions. Direct client writes
      // are limited to authenticated linked users for non-demo expansion work.
      allow create: if isLinkedToHousehold(request.resource.data.householdId);
      allow update: if isLinkedToHousehold(resource.data.householdId);
      allow delete: if false;
    }

    match /medicationLogs/{logId} {
      allow read: if isDemoReadableHousehold(resource.data.householdId) || isLinkedToHousehold(resource.data.householdId);
      // Medication response classification and logging are authoritative backend work.
      allow create: if isLinkedToHousehold(request.resource.data.householdId);
      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isDemoReadableHousehold(resource.data.householdId) || isLinkedToHousehold(resource.data.householdId);
      // Alert creation should be server-owned. Client update remains for future
      // authenticated acknowledgement flows only.
      allow create: if isLinkedToHousehold(request.resource.data.householdId);
      allow update: if isLinkedToHousehold(resource.data.householdId);
      allow delete: if false;
    }

    match /scriptUploads/{uploadId} {
      allow read: if isDemoReadableHousehold(resource.data.householdId) || isLinkedToHousehold(resource.data.householdId);
      allow create: if isDemoHousehold(request.resource.data.householdId) || isCaregiverFor(request.resource.data.householdId);
      allow update: if isDemoHousehold(resource.data.householdId) || isCaregiverFor(resource.data.householdId);
      allow delete: if false;
    }

    match /voiceReminders/{voiceReminderId} {
      allow read: if isDemoReadableHousehold(resource.data.householdId) || isLinkedToHousehold(resource.data.householdId);
      // Demo/MVP recorded voice reminders. Production should enforce caregiver consent,
      // household membership, file ownership, deletion audit trails, and senior opt-out.
      allow create: if (
        isDemoHousehold(request.resource.data.householdId) ||
        isCaregiverFor(request.resource.data.householdId)
      ) &&
        request.resource.data.consentConfirmed == true &&
        request.resource.data.messageType == 'recorded';
      allow update: if false;
      allow delete: if isDemoHousehold(resource.data.householdId) || isCaregiverFor(resource.data.householdId);
    }
  }
}
